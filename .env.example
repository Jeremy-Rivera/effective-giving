# YouTube video IDs (unlisted). Control sees Segment 1 only; Treatment sees Segment 1 + 2 as one video.
NEXT_PUBLIC_VIDEO_CONTROL_ID=REPLACE_ME
NEXT_PUBLIC_VIDEO_TREATMENT_ID=REPLACE_ME
# Minimum fraction of the video that must play before the Continue button unlocks (0 to 1)
NEXT_PUBLIC_VIDEO_GATE=0.9

# Supabase (server-only; never prefix with NEXT_PUBLIC_). Project Settings > API.
# Without these, /api/submit returns 500 in production. In `npm run dev` it
# logs a warning and prints the record instead of saving it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
